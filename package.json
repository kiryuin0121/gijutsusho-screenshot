{
  "name": "gijutsusho-screenshot",
  "version": "1.0.0",
  "description": "ページ送り形式のWebページを順番にスクリーンショットしてPDFにまとめるスクリプト",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "playwright": "^1.65.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
